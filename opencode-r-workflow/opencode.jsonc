{
  "$schema": "https://opencode.ai/config.json",

  // Orchestration is the default agent. Its Phase 0 startup check
  // redirects you to the interviewer when there are no active objectives.
  "default_agent": "project-manager",

  // Providers used by this project.
  //
  //   opencode-go  primary. Cache reads on the Go gateway are far cheaper
  //                than input tokens and cache writes are free on most Go
  //                models. setCacheKey forces a stable cache key on every
  //                request; promptCacheRetention "24h" (documented max)
  //                keeps the human approval gates cheap. If the schema
  //                rejects promptCacheRetention here, drop it; setCacheKey
  //                is the load-bearing option.
  //
  //   deepseek     fallback for DeepSeek-family models. Uses your personal
  //                DeepSeek API key (much cheaper than routing DeepSeek
  //                through OpenRouter). OpenAI-compatible endpoint.
  //
  //   openrouter   fallback for everything NOT on DeepSeek (currently just
  //                GLM). OpenRouter's provider-failover kicks in for free.
  //
  // Which model each agent uses is set in the agent .md files (default =
  // opencode-go) or overridden by the fallback overlay at
  // .opencode/profiles/fallback-overlay.json (activated by
  // scripts/opencode-fallback). See README "Falling Back Off opencode-go".
  "provider": {
    "opencode-go": {
      "options": {
        "setCacheKey": true,
        "promptCacheRetention": "24h"
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" }
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
